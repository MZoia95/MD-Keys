{
    "version": "1.0",
    "templates": [
        {
            "id": "excel-general",
            "name": "Excel — General",
            "description": "Essential Excel shortcuts for everyday spreadsheet work",
            "category": "Productivity",
            "os": "both",
            "keys": {
                "M1":  {
                    "label": "SUM",
                    "windows": {"type": "string", "value": "=SUM("},
                    "mac":     {"type": "string", "value": "=SUM("}
                },
                "M2":  {
                    "label": "VLOOKUP",
                    "windows": {"type": "string", "value": "=VLOOKUP("},
                    "mac":     {"type": "string", "value": "=VLOOKUP("}
                },
                "M3":  {
                    "label": "XLOOKUP",
                    "windows": {"type": "string", "value": "=XLOOKUP("},
                    "mac":     {"type": "string", "value": "=XLOOKUP("}
                },
                "M4":  {
                    "label": "IF",
                    "windows": {"type": "string", "value": "=IF("},
                    "mac":     {"type": "string", "value": "=IF("}
                },
                "M5":  {
                    "label": "Filter",
                    "windows": {"type": "shortcut", "value": ["ctrl", "shift", "l"]},
                    "mac":     {"type": "shortcut", "value": ["cmd", "shift", "f"]}
                },
                "M6":  {
                    "label": "Table",
                    "windows": {"type": "shortcut", "value": ["ctrl", "t"]},
                    "mac":     {"type": "shortcut", "value": ["cmd", "t"]}
                },
                "M7":  {
                    "label": "Edit Cell",
                    "windows": {"type": "key", "value": "f2"},
                    "mac":     {"type": "key", "value": "f2"}
                },
                "M8":  {
                    "label": "New Line",
                    "windows": {"type": "shortcut", "value": ["alt", "enter"]},
                    "mac":     {"type": "shortcut", "value": ["ctrl", "option", "enter"]}
                },
                "M9":  {
                    "label": "Currency",
                    "windows": {"type": "shortcut", "value": ["ctrl", "shift", "4"]},
                    "mac":     {"type": "shortcut", "value": ["cmd", "shift", "4"]}
                },
                "M10": {
                    "label": "Autofit Col",
                    "windows": {"type": "sequence", "value": ["alt", "h", "o", "i"]},
                    "mac":     {"type": "shortcut", "value": ["cmd", "option", "0"]}
                },
                "M11": {
                    "label": "Show Formula",
                    "windows": {"type": "shortcut", "value": ["ctrl", "grave"]},
                    "mac":     {"type": "shortcut", "value": ["cmd", "grave"]}
                },
                "M12": {
                    "label": "Calc Now",
                    "windows": {"type": "key", "value": "f9"},
                    "mac":     {"type": "key", "value": "f9"}
                }
            }
        },
